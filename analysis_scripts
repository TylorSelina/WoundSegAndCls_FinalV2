import pandas as pd
import numpy as np
from sklearn.metrics import accuracy_score, recall_score, f1_score, cohen_kappa_score
from sklearn.utils import resample
import warnings

# Suppress sklearn warnings
warnings.filterwarnings("ignore")

# Set global random seed for reproducibility
np.random.seed(42)

# Read data
df = pd.read_excel("cleaned_analysis_data.xlsx", sheet_name="Sheet1")

# True labels column
y_true_all = df['class']

# Columns to evaluate
columns_to_evaluate = [
    'Model',
    'Chief_Attending_Surgeon',
    'Resident_Physician',
    'Wound_Care_Nurse', 
    'Emergency_Nurse'
]

# Evaluation function: Point estimates + Bootstrap confidence intervals
def evaluate_with_bootstrap(y_true_all, y_pred_all, n_iterations=1000):
    """
    Evaluate classification performance with bootstrap confidence intervals
    
    Parameters:
    y_true_all: array-like, true labels
    y_pred_all: array-like, predicted labels  
    n_iterations: int, number of bootstrap iterations
    
    Returns:
    dict: Evaluation metrics with point estimates and 95% CIs
    """
    results = {
        "Accuracy_Point": np.nan,
        "Sensitivity_Point": np.nan,
        "F1_Score_Point": np.nan,
        "Kappa_Point": np.nan,
        "Accuracy_CI_95": (np.nan, np.nan),
        "Sensitivity_CI_95": (np.nan, np.nan), 
        "F1_Score_CI_95": (np.nan, np.nan),
        "Kappa_CI_95": (np.nan, np.nan)
    }

    try:
        # Point estimates
        accuracy_point = accuracy_score(y_true_all, y_pred_all)
        sensitivity_point = recall_score(y_true_all, y_pred_all, average='macro', zero_division=0)
        f1_point = f1_score(y_true_all, y_pred_all, average='macro', zero_division=0)
        kappa_point = cohen_kappa_score(y_true_all, y_pred_all)

        results.update({
            "Accuracy_Point": round(accuracy_point, 3),
            "Sensitivity_Point": round(sensitivity_point, 3), 
            "F1_Score_Point": round(f1_point, 3),
            "Kappa_Point": round(kappa_point, 3)
        })

        # Bootstrap confidence intervals
        accuracy_list, sensitivity_list, f1_list, kappa_list = [], [], [], []
        data = pd.DataFrame({'true_labels': y_true_all, 'predictions': y_pred_all})

        for iteration in range(n_iterations):
            # Resample with replacement
            sample_data = resample(data, replace=True, n_samples=len(data))
            y_true_bootstrap = sample_data['true_labels']
            y_pred_bootstrap = sample_data['predictions']
            
            # Calculate metrics for bootstrap sample
            accuracy_list.append(accuracy_score(y_true_bootstrap, y_pred_bootstrap))
            sensitivity_list.append(recall_score(y_true_bootstrap, y_pred_bootstrap, 
                                              average='macro', zero_division=0))
            f1_list.append(f1_score(y_true_bootstrap, y_pred_bootstrap, 
                                   average='macro', zero_division=0))
            kappa_list.append(cohen_kappa_score(y_true_bootstrap, y_pred_bootstrap))

        def calculate_confidence_interval(metric_list):
            """Calculate 95% confidence interval from bootstrap samples"""
            lower_bound = np.percentile(metric_list, 2.5)
            upper_bound = np.percentile(metric_list, 97.5)
            return (round(lower_bound, 3), round(upper_bound, 3))

        results.update({
            "Accuracy_CI_95": calculate_confidence_interval(accuracy_list),
            "Sensitivity_CI_95": calculate_confidence_interval(sensitivity_list),
            "F1_Score_CI_95": calculate_confidence_interval(f1_list),
            "Kappa_CI_95": calculate_confidence_interval(kappa_list)
        })

    except Exception as error:
        print(f"Error in evaluation: {error}")
        # Optionally re-raise or handle specific exceptions

    return results

# Evaluate each column
evaluation_results = {}
for column_name in columns_to_evaluate:
    print(f"Evaluating: {column_name}")
    evaluation_results[column_name] = evaluate_with_bootstrap(df['class'], df[column_name])

# Create results dataframe
results_dataframe = pd.DataFrame(evaluation_results).T

# Save results to Excel
results_dataframe.to_excel("model_evaluation_results.xlsx")
print("Results exported to: model_evaluation_results.xlsx")

# Print summary to console
print("\n=== Evaluation Results Summary ===")
print(results_dataframe)
